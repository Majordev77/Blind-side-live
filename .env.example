# Copy to .env and fill in. Never commit .env.

# "local" runs everything on this machine with no cloud account.
# "azure" uses the Azure services below.
BLINDSIDE_MODE=local

# Which model the agents use: "github" (GitHub Models), "foundry" (Microsoft Foundry on Azure), "foundry-local"
# (Foundry Local on this machine, no Azure subscription) or "offline" (no model: templates).
BLINDSIDE_MODEL=offline

# Microsoft Foundry (BLINDSIDE_MODEL=foundry): the model deployment name, and either the
# deployment's OpenAI-compatible base URL (ending in /openai/v1) or the Azure OpenAI endpoint.
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_OPENAI_BASE_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
# Leave empty to sign in with your Azure identity (az login); set only if you must use a key.
FOUNDRY_API_KEY=

# Foundry Local (BLINDSIDE_MODEL=foundry-local): the model id, loaded first with `foundry model load <id>`.
# FOUNDRY_LOCAL_URL is found automatically from the running service; set it only to override.
FOUNDRY_LOCAL_MODEL=phi-4-mini

# Offline writer only: share of first drafts given a planted wrong number, to exercise the verifier (0 to 1).
BLINDSIDE_FAULT_RATE=0

# Azure AI Speech: key and region of the Speech resource.
SPEECH_KEY=
SPEECH_REGION=

# GitHub Models (BLINDSIDE_MODEL=github): a fine-grained personal access token with the
# "Models: read" permission, and the model id.
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini
