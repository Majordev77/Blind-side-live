# Copy to .env and fill in. Never commit .env.

# "local" runs everything on this machine with no cloud account.
# "azure" uses the Azure services below.
BLINDSIDE_MODE=local

# Model for the agents.
# Microsoft Foundry project endpoint and model deployment name (Azure mode).
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
# GitHub Models fallback while Azure access is pending: a GitHub token with models access.
GITHUB_TOKEN=

# Azure AI Speech: key and region of the Speech resource.
SPEECH_KEY=
SPEECH_REGION=
